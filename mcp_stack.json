{
  "mcpServers": {
    "auto-prompt-engine": {
      "command": "uv",
      "args": ["run", "--directory", "D:/code/automatic-promt", "engine", "serve-mcp", "--config", "config.yaml"]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from", "git+https://github.com/oraios/serena",
        "serena", "start-mcp-server",
        "--context", "ide-assistant",
        "--project", "D:/code/target-repo"
      ]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    }
  }
}
